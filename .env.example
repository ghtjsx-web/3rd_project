# =====================================================================
# FigIndex 환경변수 템플릿 (Onpod 배포 및 로컬 실행용)
# =====================================================================

# 1. AI API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# 2. AI 모델 설정
VISION_MODEL=gemini-3.8-flash
RATE_LIMIT_DELAY=2.0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 3. Qdrant 벡터 DB 설정
# - 로컬 개발 (Docker Compose 권장): QDRANT_MODE=server, QDRANT_URL=http://qdrant:6333 (호스트 직접 실행 시 http://localhost:6333)
# - Onpod 배포 (단독 컨테이너 권장): QDRANT_MODE=local, QDRANT_LOCAL_PATH=/data/qdrant_local
QDRANT_MODE=server
QDRANT_URL=http://localhost:6333
QDRANT_LOCAL_PATH=/data/qdrant_local
QDRANT_COLLECTION=figindex_elements

# 4. 서비스 주소 및 보안
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
ADMIN_PASSWORD=0000

# 5. 데이터 저장소 경로
DATA_DIR=/data
CROPS_DIR=/data/crops
PDFS_DIR=/data/pdfs
CACHE_DIR=/data/cache

# 6. 배포 서버 포트 (Onpod 환경 대응)
PORT=8000
