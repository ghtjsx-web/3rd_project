# ==============================================================================
# Environment & Secrets (모든 디렉터리의 민감한 .env 파일 제외, .env.example은 보존)
# ==============================================================================
.env
.env.*
*.env
!.env.example
!**/.env.example

# ==============================================================================
# Vector DB & Heavy Storage (Qdrant 스토리지 및 캐시)
# ==============================================================================
qdrant_storage/
qdrant_data/
**/qdrant_storage/**
**/qdrant_data/**

# 대용량 데이터 및 모델 캐시 (폴더 유지를 위한 .gitkeep만 추적)
**/data/**
!**/data/**/
!**/data/**/.gitkeep
**/model_cache/**
!**/model_cache/**/.gitkeep
**/crops/**
!**/crops/**/.gitkeep
**/pdfs/**
!**/pdfs/**/.gitkeep

# ==============================================================================
# Python & Virtual Environments
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ==============================================================================
# Node.js & Frontend (Next.js / React)
# ==============================================================================
node_modules/
.next/
out/
build/
dist/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# OS & Editor Files
# ==============================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.log
