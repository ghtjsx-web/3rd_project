# =====================================================================
# FigIndex 환경변수 템플릿 (Onpod 배포 및 로컬 실행용)
# =====================================================================

# 1. AI API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# 2. AI 모델 설정
VISION_MODEL=gemini-3.8-flash
RATE_LIMIT_DELAY=2.0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 3. Qdrant 벡터 DB 설정
# QDRANT_MODE: 'server' (포트 6333 통신) 또는 'local' (단일 컨테이너 임베디드 파일 모드)
QDRANT_MODE=server
QDRANT_URL=http://qdrant:6333
QDRANT_LOCAL_PATH=/data/qdrant_local
QDRANT_COLLECTION=figindex_elements

# 4. 서비스 주소 및 보안
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
ADMIN_PASSWORD=figindex2026!

# 5. 데이터 저장소 경로
DATA_DIR=/data
CROPS_DIR=/data/crops
PDFS_DIR=/data/pdfs
CACHE_DIR=/data/cache

# 6. 배포 서버 포트 (Onpod 환경 대응)
PORT=8000
